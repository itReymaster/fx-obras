PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="file:./dev.db"

# sqlite (default) | mssql — obras v2 (pode ser sobrescrito em runtime pelo circuit breaker)
SQL_DIALECT=mssql

# Circuit breaker (troca sqlite<->mssql sem redeploy)
# POST /api/v2/ops/db-circuit  Authorization: Bearer <token>
CIRCUIT_BREAKER_TOKEN=change-me-in-production
# Opcional: caminho do arquivo de override (default: data/sql-dialect.breaker)
# SQL_DIALECT_BREAKER_FILE=

# SQL Server: auth ERP Flex + pool Sequelize (mesmas DB_*).
# Queries do app usam FX_OBRAS_SCHEMA.Tabela — NAO altere DEFAULT_SCHEMA do UserService.
DB_HOST=SEU_SERVIDOR
DB_PORT=1433
DB_DATABASE=SEU_BANCO
DB_USER=UserService
DB_PASSWORD=your_password_here
# Opcional: use Base64 para evitar problemas com caracteres especiais (ex: #)
# Exemplo (Linux): echo -n 'Service@#123' | base64
# Exemplo (PowerShell): [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes('Service@#123'))
DB_PASSWORD_B64=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_LOGIN_PROCEDURE=dbo.SPAuthLogin

# Pool Sequelize (nao herda so de DB_ENCRYPT)
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
# Schema das tabelas do app (queries usam fx_obras.Tabela — NAO altere DEFAULT_SCHEMA do UserService)
FX_OBRAS_SCHEMA=fx_obras

UPLOAD_DIR=uploads/construction-opportunities
MAX_PHOTOS_PER_OPPORTUNITY=15
MAX_PHOTO_SIZE_MB=10

# E-mail (Resend - https://resend.com)
# Crie uma API Key em: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
NOTIFICATION_EMAIL=imarcesil@gmail.com
